<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1e293b">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GyroSync Native"
        android:textColor="#ffffff"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="High-Precision Sensor Streamer"
        android:textColor="#94a3b8"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/editIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Server IP (e.g. 192.168.1.10)"
        android:textColor="#ffffff"
        android:textColorHint="#64748b"
        android:backgroundTint="#3b82f6"
        android:layout_marginBottom="16dp"
        android:text="192.168.1.10" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Connect to PC"
        android:backgroundTint="#3b82f6"
        android:textColor="#ffffff"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected"
        android:textColor="#f87171"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Alpha (Z):" android:textColor="#94a3b8" />
        <TextView android:id="@+id/valAlpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="#ffffff" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Beta (X):" android:textColor="#94a3b8" />
        <TextView android:id="@+id/valBeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="#ffffff" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:layout_width="100dp" android:layout_height="wrap_content" android:text="Gamma (Y):" android:textColor="#94a3b8" />
        <TextView android:id="@+id/valGamma" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textColor="#ffffff" android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
